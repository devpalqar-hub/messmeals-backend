// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  COMPLETED
  UNDELIVERED
  CANCELLED
}

/// Status for a single variation within a delivery (e.g. Breakfast DELIVERED, Dinner UNDELIVERED)
enum VariationStatus {
  PENDING
  DELIVERED
  COMPLETED
  UNDELIVERED
  CANCELLED
}

enum Role {
  USER
  SUPERADMIN
  MESSADMIN
  DELIVERYAGENT
}

enum ScheduleType {
  EVERYDAY
  CUSTOM
  MONTHLY
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum EnquiryType {
  USER
  MESS_OWNER
}

enum FoodType {
  VEG
  NON_VEG
  MIXED
}

enum Tags {
  HOME_STYLE_FOOD
  MONTHLY_PLANS
  DAILY_FRESH_MEALS
  FIXED_MENU
  HYGIENIC_KITCHEN
  AFFORDABLE_PRICING
  VEG_AND_NON_VEG
  ON_TIME_SERVING
  QUALITY_INGREDIENTS
  CONSISTENT_TASTE
  STUDENT_FRIENDLY
  FAMILY_MESS
  FLEXIBLE_BOOKING
  NO_HIDDEN_CHARGES
  TRUSTED_MESS
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

/// DEBIT = a charge that raises the amount a customer owes a mess (a monthly plan's
/// lump charge at subscription creation, or one daily-plan delivery completing).
/// CREDIT = money the mess has received for/from the customer (a payment, including
/// the wallet-settled amount at registration). Outstanding balance owed by the
/// customer to the mess = sum(DEBIT) - sum(CREDIT) for that (customer, mess) pair.
enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerEntryReason {
  /// Monthly plan: the full plan charge recorded once at subscription creation/extension.
  MONTHLY_PLAN_CHARGE
  /// Daily plan: one day's charge, recorded only once that delivery's variations are
  /// all marked complete — a daily plan is never charged upfront.
  DAILY_DELIVERY_CHARGE
  /// A payment received from the customer (gateway, wallet-settlement, or manually
  /// recorded by a mess admin/superadmin).
  PAYMENT_RECEIVED
  /// A previously-recorded CREDIT being clawed back (e.g. a daily-plan delivery/day
  /// cancellation refunded to the customer's wallet) — recorded as a DEBIT so the
  /// ledger balance reflects that the mess no longer holds that money.
  REFUND_ADJUSTMENT
  /// Manual correction by a superadmin/mess admin, outside the normal flows above.
  MANUAL_ADJUSTMENT
}

/// Staff/admin identity table — MESSADMIN, SUPERADMIN, and DELIVERYAGENT accounts.
/// Customer (role=USER) accounts live in their own `Customer` table (see below); the
/// `Role` enum is still used app-wide (JWT payload / `@Roles(Role.USER)` guards) even
/// though no row here ever carries `role: USER` anymore.
model User {
  id                     String                  @id @default(uuid())
  name                   String
  phone                  String                  @unique
  email                  String?                 @unique
  otp                    String?
  expiresAt              DateTime?
  is_verified            Boolean                 @default(false)
  is_active              Boolean                 @default(true)
  role                   Role                    @default(USER)
  password               String?
  deliveryPartnerProfile DeliveryPartnerProfile?
  messAdminProfile       MessAdminProfile?
  expenses               Expense[]

  // Onboarding relations
  websiteOfferClaims WebsiteOfferClaim[]
  onboardingSessions OnboardingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Customer identity table — a structural twin of `User`'s account fields, scoped to
/// role=USER accounts only. Split out from `User` so customer accounts don't share an
/// identity table with mess-admin/superadmin/delivery-agent staff accounts. `phone`/
/// `email` uniqueness here is enforced together with `User`'s at the application layer
/// (see `isPhoneOrEmailTaken` in src/common/utility) since MySQL can't express a unique
/// constraint spanning two tables.
model Customer {
  id              String           @id @default(uuid())
  name            String
  phone           String           @unique
  email           String?          @unique
  otp             String?
  expiresAt       DateTime?
  is_verified     Boolean          @default(false)
  is_active       Boolean          @default(true)
  password        String?
  customerProfile CustomerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id                String   @id @default(uuid())
  walletAmount      Decimal? @default(0.00)
  address           String?  @db.LongText
  current_location  String?
  latitude_logitude String?
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveries          Deliveries[]
  userSubscriptions   UserSubscriptions[]
  addresses           UserAddress[]
  Wallet              Wallet?
  Testimonials        Testimonials[]
  deliveryAssignments DeliveryAssignment[]
  ledgerTransactions  CustomerMessTransaction[]
}

model UserSubscriptions {
  id                       String       @id @default(uuid())
  start_date               DateTime
  end_date                 DateTime?
  pause_start_date         DateTime?
  pause_end_date           DateTime?
  cancellation_start_date  DateTime?
  cancellation_end_date    DateTime?
  scheduleType             ScheduleType @default(EVERYDAY)
  selectedDays             Json?
  totalPrice               Decimal      @default(0.00)
  discount                 Decimal      @default(0.00)
  discountedPrice          Decimal      @default(0.00)
  deliveryPartnerProfileId String?
  userAddressId            String?
  planId                   String
  messId                   String
  is_active                Boolean      @default(true)
  cancelled_on             DateTime?
  customerProfileId        String?
  deliveryPriority         Int?

  createdAt DateTime  @default(now())
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt DateTime?

  isActive Boolean @default(true)

  DeliveryPartnerProfile DeliveryPartnerProfile? @relation(fields: [deliveryPartnerProfileId], references: [id])
  plan                   Plans                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  CustomerProfile        CustomerProfile?        @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  mess                   Mess                    @relation(fields: [messId], references: [id], onDelete: Cascade)
  UserAddress            UserAddress?            @relation(fields: [userAddressId], references: [id])
  deliveries             Deliveries[]
  payments               Payments[]
  ledgerTransactions     CustomerMessTransaction[]

  @@unique([messId, deliveryPriority])
  @@index([messId, deliveryPriority])
  @@index([deletedAt])
}

model DeliveryPartnerProfile {
  id             String   @id @default(uuid())
  deliveryCounts Int?
  deliveryRegion String?
  isonline       Boolean  @default(true)
  address        String?  @db.LongText
  userId         String   @unique
  messId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mess                Mess                 @relation(fields: [messId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries          Deliveries[]
  userSubscriptions   UserSubscriptions[]
  Testimonials        Testimonials[]
  deliveryAssignments DeliveryAssignment[]
}

model Plans {
  id          String    @id @default(uuid())
  planName    String
  price       Decimal   @default(0.00)
  minPrice    Decimal?
  description String?   @db.Text
  messId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt   DateTime?
  mess        Mess      @relation(fields: [messId], references: [id], onDelete: Cascade)

  isMonthlyPlan Boolean @default(false)
  isDailyPlan   Boolean @default(true)
  isActive      Boolean @default(true)

  /// Running count of customers who have subscribed to this plan — used by the
  /// public "popular plans" listing (GET /open/popular-plans).
  totalCustomers Int @default(0)

  /// The plan's own weekly schedule, set by the mess owner. EVERYDAY (default) means the
  /// plan runs every day and places no restriction on a subscriber's chosen days. CUSTOM
  /// means the plan only runs on `availableDays` — a subscriber's own scheduleType/
  /// selectedDays then default to these when omitted, and must be a subset of these when
  /// provided (see CustomersService.computePlanPricing).
  scheduleType ScheduleType @default(EVERYDAY)

  /// Weekdays the plan is available on — only meaningful when scheduleType = CUSTOM.
  /// Stored as a JSON array of DayOfWeek strings, e.g. ["MONDAY", "WEDNESDAY", "FRIDAY"].
  availableDays Json?

  images            PlanImages[]
  usersubscriptions UserSubscriptions[]
  deliveries        Deliveries[]
  Variation         Variation[]
  Enquiry           Enquiry[]
  menus             Menu[]
  planPricing       PlanPricing?

  @@index([deletedAt])
}

model PlanImages {
  id        String    @id @default(uuid())
  planId    String
  url       String
  altText   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt DateTime?

  plan Plans @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_images")
}

model Variation {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       Plans[]

  isActive             Boolean             @default(true)
  deliveryVariations   DeliveryVariation[]
  deliveryAssignment   DeliveryAssignment? @relation(fields: [deliveryAssignmentId], references: [id])
  deliveryAssignmentId String?
}

/// A weekly menu for a mess: a name plus a per-weekday schedule. `schedule` is keyed by
/// DayOfWeek (only days that have entries are present) and each day holds a list of
/// { variationId, items } entries — e.g. Monday could have both a Breakfast and a Lunch entry.
/// Shape:
/// {
///   "MONDAY": [ { "variationId": "...", "items": "Rice, Dal, Sabzi, Roti" } ],
///   "TUESDAY": [ { "variationId": "...", "items": "Idli, Sambar" } ]
/// }
/// Optionally linked to one or more plans of the same mess via Plans.menuIds (a plan need not
/// have a menu, and the same menu can be reused across several plans of that mess).
model Menu {
  id        String   @id @default(uuid())
  messId    String
  name      String // menu_name
  schedule  Json // { [DayOfWeek]: { variationId: string; items: string }[] }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess  Mess    @relation(fields: [messId], references: [id], onDelete: Cascade)
  plans Plans[] // optional — the same menu can link to multiple plans of this mess

  @@index([messId])
}

/// Tracks the status of each variation (Breakfast/Lunch/Dinner) within a single delivery.
model DeliveryVariation {
  id          String          @id @default(uuid())
  deliveryId  String
  variationId String
  status      VariationStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt   DateTime?

  delivery  Deliveries @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  variation Variation  @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, variationId])
  @@index([deliveryId])
  @@index([variationId])
}

model Deliveries {
  id             String          @id @default(uuid())
  date           DateTime
  status         DeliveryStatus?
  action         String?
  customerId     String
  planId         String
  partnerId      String?
  messId         String
  subscriptionId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  isActive  Boolean   @default(true)
  sequence  Int?      @default(0)
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt DateTime?

  customer           CustomerProfile         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan               Plans                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  partner            DeliveryPartnerProfile? @relation(fields: [partnerId], references: [id])
  mess               Mess                    @relation(fields: [messId], references: [id], onDelete: Cascade)
  UserSubscriptions  UserSubscriptions?      @relation(fields: [subscriptionId], references: [id])
  deliveryVariations DeliveryVariation[]
  deliveryAssignment DeliveryAssignment?
  ledgerTransactions CustomerMessTransaction[]

  @@index([deletedAt])
}

model Mess {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  features    Json?
  address     String? @db.LongText
  phone       String?
  email       String?
  /// Optional icon/logo — a public URL (e.g. uploaded via POST /s3/upload) shown for the mess.
  icon        String?
  isPremium   Boolean @default(false)
  is_active   Boolean @default(true)
  latitude    String?
  logitude    String?
  zipcode     String?

  /// URL-friendly identifier auto-generated from the mess name on create — used by the
  /// public GET /open/mess/:slug detail endpoint.
  slug String? @unique

  /// Superadmin-controlled: whether this mess is shown at all on the public website
  /// (GET /open/messes and /open/mess/:slug only ever return listed messes).
  isListed Boolean @default(false)

  /// Superadmin-controlled: whether this mess is eligible for the "featured" public
  /// listing (nearby-within-20km, shuffled order — see OpenMessService).
  isFeatured Boolean @default(false)

  foodTypes MessFoodType[] // ✅ relation
  tags      MessTag[] // ✅ relation

  is_verified  Boolean      @default(false)
  openingHours Json?
  images       MessImages[]
  location     String?
  categories   Category[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  plans                  Plans[]
  messAdmins             MessAdminProfile[]
  DeliveryPartnerProfile DeliveryPartnerProfile[]
  Deliveries             Deliveries[]
  UserSubscriptions      UserSubscriptions[]
  Testimonials           Testimonials[]
  District               District?                @relation(fields: [districtId], references: [id])
  districtId             String?
  Enquiry                Enquiry[]

  // Billing control
  billingDisabled      Boolean            @default(false)
  billingDisabledAt    DateTime?
  billingReactivatesAt DateTime?
  MessBillingConfig    MessBillingConfig?
  MessInvoice          MessInvoice[]
  menus                Menu[]

  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  ledgerTransactions CustomerMessTransaction[]

  // Onboarding relations
  businessLocation   BusinessLocation?
  businessBranding   BusinessBranding?
  websiteOfferClaim  WebsiteOfferClaim?
  onboardingSession  OnboardingSession?
  website            Website?
}

/// Per-(customer, mess) billing ledger — see LedgerEntryType/LedgerEntryReason for the
/// debit/credit semantics. Many rows can exist for the same (customerProfileId, messId)
/// pair over time; `balanceAfter` snapshots the running outstanding balance (sum(DEBIT) -
/// sum(CREDIT)) immediately after this entry, for audit without re-summing history.
/// `relatedTransactionId` optionally links a settling entry back to the one it offsets
/// (e.g. a REFUND_ADJUSTMENT pointing at the PAYMENT_RECEIVED/advance it claws back).
model CustomerMessTransaction {
  id                String            @id @default(uuid())
  customerProfileId String
  messId            String
  subscriptionId    String?
  deliveryId        String?
  type              LedgerEntryType
  reason            LedgerEntryReason
  amount            Decimal
  balanceAfter      Decimal
  note              String?
  createdAt         DateTime          @default(now())
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt         DateTime?

  relatedTransactionId String?

  customerProfile    CustomerProfile           @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  mess               Mess                      @relation(fields: [messId], references: [id], onDelete: Cascade)
  subscription       UserSubscriptions?        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  delivery           Deliveries?               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  relatedTransaction CustomerMessTransaction?  @relation("RelatedLedgerTransaction", fields: [relatedTransactionId], references: [id])
  settlements        CustomerMessTransaction[] @relation("RelatedLedgerTransaction")

  /// At most one DAILY_DELIVERY_CHARGE debit per delivery — keeps the auto-complete
  /// hook in deliveries.service.ts idempotent against retries/re-triggers.
  @@unique([deliveryId, reason])
  @@index([customerProfileId, messId])
  @@index([subscriptionId])
}

model BillingGlobalConfig {
  id                     String   @id @default(uuid())
  defaultPerCustomerRate Decimal  @default(4.00)
  defaultTrialDays       Int      @default(30)
  dueDaysBeforePeriodEnd Int      @default(5)
  graceDaysAfterDue      Int      @default(5)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model BillingTier {
  id              String   @id @default(uuid())
  minCustomers    Int
  maxCustomers    Int?
  perCustomerRate Decimal  @default(0.00)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([minCustomers, maxCustomers])
}

model MessBillingConfig {
  id                      String    @id @default(uuid())
  messId                  String    @unique
  trialEndsAt             DateTime?
  perCustomerRateOverride Decimal?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)
}

model MessInvoice {
  id            String        @id @default(uuid())
  messId        String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  customerCount Int
  rate          Decimal       @default(0.00)
  amount        Decimal       @default(0.00)
  status        InvoiceStatus @default(UNPAID)
  paidAt        DateTime?

  // Razorpay (direct mess billing payments)
  razorpayOrderId     String?   @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  razorpayPaymentMeta Json?
  paymentProcessedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, periodStart, periodEnd])
  @@index([messId, status])
  @@index([dueDate])
}

model MessImages {
  id        String   @id @default(uuid())
  messId    String
  url       String
  altText   String?
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@map("mess_images")
}

model MessAdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messes    Mess[]
}

model UserAddress {
  id               String   @id @default(uuid())
  name             String
  street           String
  townOrcity       String
  country          String?
  postcode         String
  landmark         String?
  latitudeLogitude String?
  phone            String?
  email            String?
  locationLink     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  isActive Boolean @default(true)

  User      CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  subscriptions UserSubscriptions[]
}

model Wallet {
  id           String          @id @default(uuid())
  profile      CustomerProfile @relation(fields: [userId], references: [id])
  userId       String          @unique
  walletAmount Decimal         @default(0.00)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions Transaction[]
}

model Transaction {
  id           String   @id @default(uuid())
  wallet       Wallet   @relation(fields: [walletId], references: [id])
  walletId     String
  amount       Decimal  @default(0.00) // smallest unit; positive for credit, negative for debit
  balanceAfter Decimal  @default(0.00) // wallet balance after transaction, stored to allow auditing
  meta         Json? // optional metadata: { fromUserId, toUserId, note, externalId }
  createdAt    DateTime @default(now())
}

model Payments {
  id                String    @id @default(uuid())
  subscriptionId    String
  razorpayOrderId   String    @unique
  razorpayPaymentId String?
  amount            Decimal
  status            String    @default("PENDING") // PENDING, SUCCESS, FAILED
  customerEmail     String
  customerPhone     String
  customerName      String
  metadata          Json? // Razorpay order metadata
  failureReason     String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt         DateTime?

  userSubscriptions UserSubscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model PhoneNumbers {
  id    String @id @default(uuid())
  phone String @unique
}

model Category {
  id          String  @id @default(uuid())
  name        String
  image       String?
  description String?
  isActive    Boolean @default(true)
  mess        Mess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// PENDING = a lightweight placeholder entry logged now to be completed/paid later (amount may be a guess or unset).
/// UNPAID = a fully recorded expense (amount set) with no payment recorded yet (paidAmount = 0).
/// PARTIALLY_PAID = a fully recorded expense with some but not all of `amount` paid (0 < paidAmount < amount).
/// PAID = a fully recorded expense that has been settled in full (paidAmount >= amount).
/// UNPAID/PARTIALLY_PAID/PAID are calculated from amount vs paidAmount — not set directly by the caller.
enum ExpenseStatus {
  PENDING
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// Expense categories are managed per-mess by the mess owner (e.g. Groceries, Rent, Staff Salary).
model ExpenseCategory {
  id          String   @id @default(uuid())
  messId      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mess     Mess      @relation(fields: [messId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([messId, name])
  @@index([messId])
}

model Expense {
  id            String        @id @default(uuid())
  messId        String
  categoryId    String
  title         String
  amount        Decimal       @default(0.00)
  paidAmount    Decimal       @default(0.00)
  description   String?       @db.Text
  expenseDate   DateTime      @default(now())
  paymentMethod String?
  receiptUrl    String?
  status        ExpenseStatus @default(UNPAID)
  paidAt        DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  mess      Mess            @relation(fields: [messId], references: [id], onDelete: Cascade)
  category  ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([messId])
  @@index([categoryId])
  @@index([messId, expenseDate])
  @@index([messId, status])
}

model Testimonials {
  id              String   @id @default(uuid())
  messId          String
  ratings         Int
  reviews         String
  customerId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  DeliveryagentId String?
  isActive        Boolean  @default(true)

  mess            Mess                    @relation(fields: [messId], references: [id], onDelete: Cascade)
  customer        CustomerProfile         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryPartner DeliveryPartnerProfile? @relation(fields: [DeliveryagentId], references: [id], onDelete: Cascade)
}

model District {
  id        String  @id @default(uuid())
  image     String
  name      String
  isPopular Boolean @default(false)

  mess      Mess[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id          String      @id @default(uuid())
  name        String
  email       String
  phone       String?
  planId      String?
  message     String      @db.Text
  enquiryType EnquiryType @default(USER)
  messId      String?

  plan Plans? @relation(fields: [planId], references: [id], onDelete: Cascade)

  messname  String?
  district  String?
  pincode   String?
  /// Soft-delete timestamp. NULL = active; non-NULL = deleted.
  deletedAt DateTime?

  mess      Mess?    @relation(fields: [messId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessFoodType {
  id       String   @id @default(uuid())
  messId   String
  foodType FoodType

  mess Mess @relation(fields: [messId], references: [id])

  @@unique([messId, foodType])
}

model MessTag {
  id     String @id @default(uuid())
  messId String
  tag    Tags

  mess Mess @relation(fields: [messId], references: [id])

  @@unique([messId, tag])
}

model DeliveryAssignment {
  id                String   @id @default(uuid())
  deliveryPartnerId String
  deliveryId        String   @unique
  sequence          Int      @default(0)
  assignedAt        DateTime @default(now())

  deliveryPartner   DeliveryPartnerProfile @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  delivery          Deliveries             @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customerProfile   CustomerProfile?       @relation(fields: [customerProfileId], references: [id])
  customerProfileId String?
  variations        Variation[]

  @@index([deliveryPartnerId])
}

// ============================================================
// MESSMEALS ONBOARDING – New models added for the v1 onboarding
// flow. All existing models above are UNCHANGED.
// ============================================================

/// Supported countries for kitchen location selection.
/// IN = India, AE = United Arab Emirates, QA = Qatar.
enum SupportedCountry {
  IN
  AE
  QA
}

/// Billing periods for subscription plans.
enum BillingPeriod {
  MONTHLY
  DAILY
}

/// Onboarding stages in sequence.
enum OnboardingStage {
  PHONE_VERIFICATION
  BUSINESS_DETAILS
  LOCATION
  WEBSITE_OFFER
  BRANDING
  WEBSITE_IMAGES
  MENU_DETAILS
  MENU_DAYS
  DAILY_DISHES
  PLAN_DETAILS
  PRICING
  AVAILABILITY
  PLAN_CREATED
  WEBSITE_GENERATION
  WEBSITE_READY
  COMPLETED
}

/// Status for onboarding session.
enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// Status for a website offer claim by a business owner.
enum OfferClaimStatus {
  CLAIMED
  DISMISSED
}

/// Status for website generation/publishing.
enum WebsiteStatus {
  DRAFT
  GENERATING
  GENERATED
  PUBLISHING
  PUBLISHED
  FAILED
}

/// Status for a website generation job.
enum GenerationJobStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

/// Website theme options.
enum WebsiteTheme {
  DEFAULT
  WARM
  COOL
  EARTHY
  VIBRANT
  MINIMAL
  CUSTOM
}

/// Structured business location separate from the Mess.address free-text field.
/// Determines currency and timezone server-side based on country.
model BusinessLocation {
  id          String          @id @default(uuid())
  messId      String          @unique
  country     SupportedCountry
  currency    String          // INR / AED / QAR — set server-side from country
  timezone    String          // Asia/Kolkata, Asia/Dubai, Asia/Qatar
  building    String?         @db.Text   // building / street address
  area        String?                   // area / locality
  city        String
  state       String
  postalCode  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@map("business_locations")
}

/// Business branding configuration (theme, colors, logo, cover image).
model BusinessBranding {
  id              String       @id @default(uuid())
  messId          String       @unique
  displayName     String?
  theme           WebsiteTheme @default(DEFAULT)
  primaryColor    String?      // hex color e.g. #FF5733
  secondaryColor  String?
  logoUrl         String?      @db.Text
  logoKey         String?      // S3 object key for deletion
  coverUrl        String?      @db.Text
  coverKey        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  mess         Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  galleryItems BrandingGallery[]

  @@map("business_brandings")
}

/// Gallery images belonging to a business's branding.
model BrandingGallery {
  id          String   @id @default(uuid())
  brandingId  String
  url         String   @db.Text
  s3Key       String?  // S3 object key for deletion
  altText     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branding BusinessBranding @relation(fields: [brandingId], references: [id], onDelete: Cascade)

  @@index([brandingId])
  @@map("branding_gallery")
}

/// Configurable website offer (e.g., free website for first 200 businesses).
/// Only one active config should exist — managed by superadmin.
model WebsiteOfferConfig {
  id              String   @id @default(uuid())
  maxClaims       Int      @default(200)       // e.g. first 200 businesses
  originalPrice   Decimal  @default(9999.00)   // displayed original price
  promoPrice      Decimal  @default(0.00)      // promotional price
  isEnabled       Boolean  @default(true)
  totalClaimed    Int      @default(0)         // atomic counter
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  claims WebsiteOfferClaim[]

  @@map("website_offer_configs")
}

/// Tracks whether each business has claimed or dismissed the website offer.
model WebsiteOfferClaim {
  id        String          @id @default(uuid())
  userId    String
  messId    String          @unique   // one claim record per business
  configId  String
  status    OfferClaimStatus
  claimedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mess   Mess               @relation(fields: [messId], references: [id], onDelete: Cascade)
  config WebsiteOfferConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("website_offer_claims")
}

/// OTP rate-limiting and session tracking for the new v1 onboarding OTP flow.
/// Separate from the Enquiry-based OTP session used by the existing signup flow.
model OtpSession {
  id          String   @id @default(uuid())
  phone       String
  countryCode String   @default("IN")
  sessionId   String?  // 2factor.in session ID or FALLBACK-uuid
  otp         String?  // only stored for dev/fallback
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([phone])
  @@map("otp_sessions")
}

/// Persistent onboarding session for each (user, mess) pair.
/// Tracks the current stage and which stages have been completed.
model OnboardingSession {
  id               String          @id @default(uuid())
  userId           String
  messId           String?         @unique
  currentStage     OnboardingStage @default(PHONE_VERIFICATION)
  status           OnboardingStatus @default(IN_PROGRESS)
  completedStages  Json            @default("[]")  // string[] of OnboardingStage
  metadata         Json?           // arbitrary stage-specific data
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mess   Mess? @relation(fields: [messId], references: [id], onDelete: Cascade)
  events OnboardingEvent[]

  @@index([userId])
  @@map("onboarding_sessions")
}

/// Audit trail: one record per stage transition in an onboarding session.
model OnboardingEvent {
  id          String          @id @default(uuid())
  sessionId   String
  stage       OnboardingStage
  eventType   String          // ENTERED | COMPLETED | FAILED | SKIPPED
  metadata    Json?
  createdAt   DateTime        @default(now())

  session OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("onboarding_events")
}

/// Dedicated pricing record for a subscription plan.
/// Replaces the flat price/minPrice fields for the onboarding flow
/// while keeping existing Plans.price intact for backward compat.
model PlanPricing {
  id              String       @id @default(uuid())
  planId          String       @unique
  billingPeriod   BillingPeriod @default(MONTHLY)
  regularPrice    Decimal      @default(0.00)
  discountEnabled Boolean      @default(false)
  discountedPrice Decimal?
  currency        String       @default("INR")  // INR / AED / QAR
  savings         Decimal?     // calculated server-side
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  plan Plans @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_pricings")
}

/// Generated website for a business.
model Website {
  id          String        @id @default(uuid())
  messId      String        @unique
  slug        String        @unique
  websiteUrl  String?       @db.Text
  status      WebsiteStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mess            Mess                  @relation(fields: [messId], references: [id], onDelete: Cascade)
  generationJobs  WebsiteGenerationJob[]

  @@map("websites")
}

/// Async website generation job record.
model WebsiteGenerationJob {
  id          String              @id @default(uuid())
  websiteId   String
  status      GenerationJobStatus @default(PENDING)
  attempt     Int                 @default(1)
  errorMessage String?            @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@map("website_generation_jobs")
}

