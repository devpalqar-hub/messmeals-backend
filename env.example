DATABASE_URL=""

# Mapbox Geocoding API token, used by GeocodingService for the location half of
# GET /open/search-suggestions. Without it, that endpoint's `locations` list is always empty.
MAPBOX_ACCESS_TOKEN=""

# Google Maps Platform key with the Routes API enabled — used by the delivery-work module
# to optimise two-wheeler delivery routes. Without it, routes are ordered by a local
# nearest-neighbour + 2-opt heuristic (straight-line distances, estimated ETAs, no polyline).
GOOGLE_MAPS_API_KEY=""

# How often (ms) the delivery-work module re-sorts routes for today/tomorrow whose
# deliveries changed (new subscriptions, pauses, cancellations, partner changes).
# Default 300000 (5 min). Set to 0 to disable; routes are still refreshed on read.
DELIVERY_ROUTE_SYNC_INTERVAL_MS=300000
